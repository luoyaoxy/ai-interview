RAG_SERVICE_NAME=rag-service
RAG_SERVICE_VERSION=0.2.0
RAG_API_KEY=change-me
RAG_HOST=127.0.0.1
RAG_PORT=8000
RAG_LOG_LEVEL=INFO
RAG_LOG_FORMAT=json
RAG_DATA_DIR=./data
RAG_VECTOR_DB_PATH=./data/rag.db
RAG_UPLOAD_DIR=./data/uploads
RAG_INTERVIEW_STORE_PATH=./data/interviews.json
RAG_MAX_UPLOAD_BYTES=52428800
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_API_URL=http://127.0.0.1:11434/api/embed
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_LLM_API_URL=
# Optional when DEEPSEEK_API_KEY is already available in the process environment.
RAG_LLM_API_KEY=
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=
RAG_LLM_TEMPERATURE=0.3
RAG_LLM_MAX_TOKENS=32000
RAG_LLM_TIMEOUT_SECONDS=60
RAG_SPEECH_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
RAG_SPEECH_APP_ID=
RAG_SPEECH_ACCESS_KEY=
RAG_SPEECH_APP_KEY=
RAG_SPEECH_RESOURCE_ID=volc.speech.dialog
RAG_SPEECH_TIMEOUT_SECONDS=45
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.7
RAG_RETRIEVAL_MODE=hybrid
RAG_RETRIEVAL_CANDIDATE_K=20
RAG_LEXICAL_THRESHOLD=0.3
RAG_MAX_HISTORY_TURNS=5
RAG_VERIFY_SSL=true
